table inet xray {
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;

        meta l4proto {tcp, udp} tproxy ip to :1090 meta mark set 1 accept
        meta l4proto {tcp, udp} tproxy ip6 to :1090 meta mark set 1 accept
    }

    chain output {
        type route hook output priority mangle; policy accept;

        meta mark 2 accept

        meta l4proto { tcp, udp } oifname sub_network meta mark set 1 accept
    }
}
